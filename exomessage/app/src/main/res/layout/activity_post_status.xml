<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_background"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Share Your Status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✍️"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- Status Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's on your mind?"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/statusEditText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Share your thoughts..."
            android:gravity="top|start"
            android:padding="12dp"
            android:background="@drawable/edittext_background"
            android:textSize="16sp"
            android:maxLength="500"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/postButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📝 Post Status"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/post_button_background" />

    </LinearLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Status Updates"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/viewMyStatusButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📊 View My Status Updates"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:background="@drawable/my_status_button_background"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/viewFriendsStatusButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="👥 View Friends' Status Updates"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:background="@drawable/friends_status_button_background" />

    </LinearLayout>

</LinearLayout>