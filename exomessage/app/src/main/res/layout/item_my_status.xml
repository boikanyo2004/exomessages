<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:elevation="3dp">

    <!-- Status Text -->
    <TextView
        android:id="@+id/myStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your status text here..."
        android:textSize="16sp"
        android:textColor="#333333"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="12dp" />

    <!-- Upvote Count -->
    <TextView
        android:id="@+id/myUpvoteCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❤️ 0 upvotes"
        android:textSize="14sp"
        android:textColor="#e74c3c"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Friends Who Upvoted -->
    <TextView
        android:id="@+id/friendsUpvotedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upvoted by: John, Sarah, Mike"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textStyle="italic"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- Bottom Row: Date and Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Posted Date -->
        <TextView
            android:id="@+id/myCreatedAtText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Posted: 2024-01-15"
            android:textSize="12sp"
            android:textColor="#999999" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/deleteStatusButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️ Delete"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="@drawable/delete_button_background"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:minHeight="48dp"
            android:minWidth="48dp"/>

    </LinearLayout>

</LinearLayout>